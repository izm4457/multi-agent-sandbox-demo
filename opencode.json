{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "external_directory": "deny",
    "bash": {
      "*": "ask",
      "npm run *": "allow",
      "npm test *": "allow",
      "npx vitest *": "allow",
      "npx tsc *": "allow",
      "npx eslint *": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "git commit *": "deny",
      "git push *": "deny",
      "git merge *": "deny",
      "git rebase *": "deny",
      "git reset *": "deny",
      "git checkout *": "deny",
      "git branch *": "deny",
      "npm install *": "deny",
      "npm i *": "deny",
      "rm -rf *": "deny",
      "curl *": "deny",
      "wget *": "deny"
    }
  }
}
